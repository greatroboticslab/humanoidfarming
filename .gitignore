# Ignore everything by default
*

# Allow these folders
!scripts/
!results/
!documents/
!docs/
!reports/
!integrated-training/
!integrated-training/**

# Allow README
!README.md

# Allow Python files in root
!*.py

# Inside allowed folders, allow everything
!scripts/**
!results/**
!documents/**
!docs/**
!reports/**

# Ignore large media and caches
*.mp4
*.mkv
*.avi
*.wav
whisper_cache/
hf_cache/
__pycache__/
*.pt
*.bin
*.npy
*.zip
*.tar
*.gz
*.checkpoint

# Allow specific project folder
!VideoProcessing/
!VideoProcessing/**
