
# Ignore everything by default
*

# Allow these folders
!scripts/
!results/
!documents/
!docs/
!reports/

# Allow README
!README.md

# Allow Python files in root
!*.py

# Inside scripts/, allow everything
scripts/*

# Inside results/, include only JSON, HTML, DOCX, JPG, PNG if desired
results/**/*.json
results/**/*.html
results/**/*.docx
results/**/*.jpg
results/**/*.jpeg
results/**/*.png

# Ignore large media and caches
*.mp4
*.mkv
*.avi
*.wav
whisper_cache/
hf_cache/
__pycache__/
*.pt
*.bin
*.npy
*.zip
*.tar
*.gz
*.checkpoint

!VideoProcessing/
!VideoProcessing/**
