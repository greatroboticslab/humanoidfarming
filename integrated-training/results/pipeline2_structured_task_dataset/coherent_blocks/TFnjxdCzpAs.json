        }
      ],
      "subtask_refs": [
        {
          "task_index": 1,
          "sub_index": 2
        }
      ],
      "block_preview_text": "Detail that diversions, roofs, and gutters are used to prevent manure from contacting clean water by directing water around production areas."
    },
    {
      "block_id": 3,
      "time_start": 265.71,
      "time_end": 332.11,
